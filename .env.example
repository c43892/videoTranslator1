# Used by compose.chat.yml. Copy to .env and fill locally; never commit secrets.
DEEPSEEK_API_KEY=
CHAT_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Real local engine: existing containerized GPU stack, with its global serial queue.
APP_PROFILE=local-ui
ENGINE_BACKEND=disabled
ENGINE_CONTAINER=videotranslator-api-1
# Speech recognition: whisper | scribe. Scribe labels sound events without speaker identity.
TRANSCRIPTION_PROVIDER=whisper
ELEVENLABS_API_KEY=
SCRIBE_MODEL=scribe_v2
LOCAL_STORAGE_SIGNING_SECRET=
DOCKER_COMMAND=docker
# Set APP_PROFILE=local-full and ENGINE_BACKEND=docker after the engine is ready.

# Firebase Authentication: enable Google and Email/Password in Firebase Console.
# Add localhost and your production domain to Authentication > Authorized domains.
AUTH_MODE=firebase
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
# Host directory containing firebase-admin.json (never commit it).
FIREBASE_ADMIN_CREDENTIALS_DIR=./secrets
# For a native Python launch, use the absolute path instead of the container path.
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase-admin.json

# disabled | sandbox | live. Start with sandbox; use matching Stripe test keys.
PAYMENT_MODE=disabled
PUBLIC_APP_URL=http://localhost:8090
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional paired environments. When either profile key is set, these profiles
# are authoritative; the two legacy variables above are no longer used.
STRIPE_SANDBOX_SECRET_KEY=
STRIPE_SANDBOX_WEBHOOK_SECRET=
STRIPE_LIVE_SECRET_KEY=
STRIPE_LIVE_WEBHOOK_SECRET=
# Host paths used by stripe.ps1; Compose maps the same files under /data.
PAYMENT_SANDBOX_STORE_PATH=./vt-data/chat-preview/store-stripe-sandbox.db
PAYMENT_LIVE_STORE_PATH=./vt-data/chat-preview/store-stripe-live.db
PAYMENT_SANDBOX_QUEUE_PATH=./vt-data/chat-preview/inspection-queue.db
PAYMENT_LIVE_QUEUE_PATH=./vt-data/chat-preview/inspection-queue-live.db
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# Balance units are US cents: $0.10/min, rounded up to one cent.
PRICING_VERSION=usd-cent-v1
POINT_UNITS_PER_MINUTE=10
MINIMUM_POINT_UNITS=1
YOUTUBE_DOWNLOAD_MODE=direct
# home-worker mode: comma-separated private tokens, one per Windows installation (32+ characters).
YOUTUBE_WORKER_TOKENS=
