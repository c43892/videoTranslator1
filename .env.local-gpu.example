# Copy to .env.local-gpu. Keep the real file private.
POSTGRES_PASSWORD=
ENGINE_CONTROL_TOKEN=
LOCAL_STORAGE_SIGNING_SECRET=

# Required for the repository's current transcription and translation providers.
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
TRANSCRIPTION_PROVIDER=whisper
WHISPER_MODEL=whisper-1

# Optional: use Firebase sign-in and Stripe test payments for a local full stack.
# If AUTH_MODE=firebase, place the admin JSON at secrets/firebase-admin.json.
AUTH_MODE=demo
PAYMENT_MODE=disabled
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
STRIPE_SANDBOX_SECRET_KEY=
STRIPE_SANDBOX_WEBHOOK_SECRET=

# Keep admission closed until the engine, GPU and providers are verified.
CLOUD_ACCEPT_JOBS=false
GPU_STARTS_ENABLED=false
MAX_ACTIVE_GPU_JOBS=1
