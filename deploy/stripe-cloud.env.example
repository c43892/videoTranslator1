# Inject the four secrets using your cloud secret manager, never Git or Docker images.
PAYMENT_MODE=sandbox
STRIPE_SANDBOX_SECRET_KEY=
STRIPE_SANDBOX_WEBHOOK_SECRET=
STRIPE_LIVE_SECRET_KEY=
STRIPE_LIVE_WEBHOOK_SECRET=
# Persistent volume paths; both environments must remain separate.
PAYMENT_SANDBOX_STORE_PATH=/data/store-stripe-sandbox.db
PAYMENT_LIVE_STORE_PATH=/data/store-stripe-live.db
PAYMENT_SANDBOX_QUEUE_PATH=/data/inspection-queue-sandbox.db
PAYMENT_LIVE_QUEUE_PATH=/data/inspection-queue-live.db
# Use the actual HTTPS site, not localhost or the Stripe CLI endpoint.
PUBLIC_APP_URL=https://your-app.example.com
