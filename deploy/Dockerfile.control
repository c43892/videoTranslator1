FROM python:3.12-slim-bookworm
COPY --from=docker:28-cli /usr/local/bin/docker /usr/local/bin/docker
ENV PYTHONUNBUFFERED=1 PIP_DISABLE_PIP_VERSION_CHECK=1
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg ca-certificates \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY packages/videotranslator /app/package
RUN pip install --no-cache-dir /app/package \
    && useradd --create-home studio && mkdir /data && chown studio:studio /data
USER studio
ENV APP_PROFILE=local-ui STORE_PATH=/data/store.db LOCAL_STORAGE_DIR=/data/objects PORT=8000
EXPOSE 8000
CMD ["python", "-m", "videotranslator.api"]
