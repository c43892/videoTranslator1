{
  "location": "japaneast",
  "identity": {"type": "SystemAssigned"},
  "properties": {
    "workloadProfileName": "gpu-t4",
    "configuration": {
      "activeRevisionsMode": "Multiple",
      "registries": [{"server": "vtranslatorjpe43892.azurecr.io", "identity": "system"}]
    },
    "template": {
      "containers": [
        {
          "name": "tts",
          "image": "REPLACE_TTS_IMAGE_DIGEST",
          "resources": {"cpu": 6, "memory": "48Gi"},
          "env": [{"name":"STORAGE_ROOT","value":"/data"}],
          "volumeMounts": [{"volumeName":"data","mountPath":"/data"},{"volumeName":"models","mountPath":"/models"}],
          "probes": [{"type":"Readiness","httpGet":{"path":"/health","port":8001},"initialDelaySeconds":10,"periodSeconds":15,"timeoutSeconds":5,"failureThreshold":48}]
        },
        {
          "name": "worker",
          "image": "REPLACE_ENGINE_IMAGE_DIGEST",
          "resources": {"cpu": 2, "memory": "8Gi"},
          "env": [
            {"name":"DATABASE_URL","secretRef":"worker-database-url"},
            {"name":"ELEVENLABS_API_KEY","secretRef":"elevenlabs-api-key"},
            {"name":"DEEPSEEK_API_KEY","secretRef":"deepseek-api-key"},
            {"name":"TRANSCRIPTION_PROVIDER","value":"scribe"},
            {"name":"SCRIBE_MODEL","value":"scribe_v2"},
            {"name":"TTS_URL","value":"http://localhost:8001"},
            {"name":"TTS_TOKENIZE_TIMEOUT_SECONDS","value":"600"},
            {"name":"DEMUCS_URL","value":"http://localhost:8001"},
            {"name":"STORAGE_ROOT","value":"/data"}
          ],
          "volumeMounts": [{"volumeName":"data","mountPath":"/data"}]
        }
      ],
      "volumes": [
        {"name":"data","storageType":"AzureFile","storageName":"data"},
        {"name":"models","storageType":"AzureFile","storageName":"models"}
      ],
      "scale": {
        "minReplicas": 0, "maxReplicas": 1, "pollingInterval": 30, "cooldownPeriod": 300,
        "rules": [{"name":"durable-work","custom":{
          "type":"postgresql",
          "metadata":{"query":"SELECT COUNT(*) FROM gpu_runnable_work","targetQueryValue":"1","activationTargetQueryValue":"0"},
          "auth":[{"secretRef":"scaler-connection","triggerParameter":"connection"}]
        }}]
      }
    }
  }
}
