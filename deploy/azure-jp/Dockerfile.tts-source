# Remote build option: IndexTTS-2.5 source plus exact installed dependency versions.
FROM python:3.10-slim-bookworm AS dependencies
ENV UV_LINK_MODE=copy UV_HTTP_TIMEOUT=180 GIT_LFS_SKIP_SMUDGE=1
RUN apt-get update && apt-get install -y --no-install-recommends git build-essential \
    && rm -rf /var/lib/apt/lists/* && pip install --no-cache-dir uv==0.8.22
WORKDIR /opt/index-tts
RUN git init . && git remote add origin https://github.com/index-tts/index-tts.git \
    && git fetch --depth 1 origin 39207d91c30899cad1e7c1b9eb678c241f678e55 \
    && git checkout FETCH_HEAD
COPY deploy/azure-jp/tts-requirements.lock /tmp/tts-requirements.lock
RUN uv venv --python /usr/local/bin/python /opt/index-tts/.venv \
    && uv pip sync --python /opt/index-tts/.venv/bin/python --extra-index-url https://download.pytorch.org/whl/cu128 \
       --index-strategy unsafe-best-match /tmp/tts-requirements.lock \
    && uv cache clean && rm -rf /opt/index-tts/.git
FROM python:3.10-slim-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg libsndfile1 libgomp1 \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --uid 10001 --create-home app && mkdir /data /models && chmod 1777 /data /models
COPY --from=dependencies /opt/index-tts /opt/index-tts
COPY engine/services/tts /opt/tts
COPY engine/backend/videotranslator/runtime_health.py /opt/tts/runtime_health.py
COPY deploy/azure-jp/patch-tts-cache.py /tmp/patch-tts-cache.py
RUN python /tmp/patch-tts-cache.py && rm /tmp/patch-tts-cache.py
ENV PYTHONPATH=/opt/index-tts PATH=/opt/index-tts/.venv/bin:$PATH \
    PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 HOME=/models NUMBA_CACHE_DIR=/tmp/numba \
    MPLCONFIGDIR=/tmp/matplotlib XDG_CACHE_HOME=/tmp/cache \
    MODEL_DIR=/models/checkpoints-2.5 HF_HOME=/models/huggingface HF_HUB_CACHE=/models/huggingface/hub \
    HF_HUB_DISABLE_XET=1 STORAGE_ROOT=/data
USER 10001
WORKDIR /opt/tts
CMD ["python", "/opt/tts/server.py"]
