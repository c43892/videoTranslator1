FROM python:3.12-slim-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg libsndfile1 ca-certificates \
    && rm -rf /var/lib/apt/lists/* && useradd --uid 10001 --create-home app \
    && mkdir /data && chmod 1777 /data
WORKDIR /app
COPY engine/pyproject.toml ./
COPY engine/backend ./backend
RUN pip install --no-cache-dir .
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 STORAGE_ROOT=/data
USER 10001
CMD ["python", "-m", "videotranslator.cloud_worker"]
